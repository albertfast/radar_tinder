{
  "cli": {
    "version": ">= 16.30.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "YARN_IGNORE_ENGINES": "1"
      },
      "ios": {
        "simulator": false,
        "image": "auto"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "adhoc": {
      "developmentClient": true,
      "credentialsSource": "local",
      "distribution": "internal",
      "env": {
        "EXPO_SKIP_DOCTOR_CHECK": "1"
      },
      "ios": {
        "simulator": false,
        "image": "auto"
      }
    },
    "preview": {
      "credentialsSource": "local",
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "image": "auto"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "credentialsSource": "local",
      "distribution": "store",
      "developmentClient": false,
      "env": {
        "EXPO_SKIP_DOCTOR_CHECK": "1"
      },
      "ios": {
        "simulator": false,
        "image": "auto"
      }
    },
    "production": {
      "credentialsSource": "local",
      "distribution": "store",
      "developmentClient": false,
      "env": {
        "EXPO_SKIP_DOCTOR_CHECK": "1"
      },
      "ios": {
        "simulator": false,
        "image": "auto"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "apk": {
      "credentialsSource": "local",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6758140652",
        "ascApiKeyPath": "${EXPO_APPLE_APP_STORE_CONNECT_API_KEY_PATH}",
        "ascApiKeyIssuerId": "${EXPO_APPLE_APP_STORE_CONNECT_API_KEY_ISSUER_ID}",
        "ascApiKeyId": "${EXPO_APPLE_APP_STORE_CONNECT_API_KEY_ID}"
      }
    },
    "production": {
      "android": {
       "serviceAccountKeyPath": "./google-service-account.json",
       "track": "internal"
      }
    }
  }
}
